{
    "homework_check": {
        "description": "作业检测",
        "type": "object",
        "items": {
            "enable_homework_check": {
                "description": "启用作业自动检测（总开关）",
                "hint": "关闭后不再定时发包检测，也不推送作业通知；不影响 /更新作业 手动命令",
                "type": "bool",
                "default": true
            },
            "homework_check_interval": {
                "description": "作业定时检测间隔（分钟）",
                "hint": "范围建议 10-120 分钟",
                "type": "int",
                "default": 30
            },
            "homework_due_warn_hours": {
                "description": "作业快到期提醒阈值（小时）",
                "hint": "距截止时间小于该值（小时）时推送提醒；进入窗口后按 6h/1h 分级再各提醒一次（自动去重，不重复轰炸）",
                "type": "int",
                "default": 24
            },
            "enable_new_homework_notify": {
                "description": "新作业发布时推送通知",
                "type": "bool",
                "default": true
            },
            "enable_due_warning": {
                "description": "作业快到期时推送提醒",
                "type": "bool",
                "default": true
            }
        }
    },
    "rollcall_check": {
        "description": "点名检测",
        "type": "object",
        "items": {
            "enable_rollcall_check": {
                "description": "启用点名自动检测（总开关）",
                "hint": "关闭后不再定时发包检测，也不推送点名通知",
                "type": "bool",
                "default": true
            },
            "rollcall_default_interval": {
                "description": "无课表时的点名检测间隔（分钟）",
                "hint": "范围建议 1-60 分钟",
                "type": "int",
                "default": 5
            },
            "rollcall_in_class_interval": {
                "description": "有课表时，上课时间内的点名检测间隔（分钟）",
                "hint": "范围建议 1-10 分钟；含课前提前检测窗口",
                "type": "int",
                "default": 1
            },
            "rollcall_class_precheck_minutes": {
                "description": "上课前提前开始检测的分钟数",
                "hint": "范围建议 0-15 分钟",
                "type": "int",
                "default": 5
            },
            "enable_rollcall_notify": {
                "description": "新点名时推送通知",
                "type": "bool",
                "default": true
            }
        }
    },
    "quiet_hours": {
        "description": "免打扰时段",
        "type": "object",
        "items": {
            "quiet_hours_enabled": {
                "description": "启用免打扰时段（时段内暂停定时推送与检测）",
                "type": "bool",
                "default": true
            },
            "quiet_hours_start": {
                "description": "免打扰开始时间",
                "hint": "HH:MM 格式；跨午夜时早于结束时间，如 23:00 → 07:00",
                "type": "string",
                "default": "23:00"
            },
            "quiet_hours_end": {
                "description": "免打扰结束时间",
                "hint": "HH:MM 格式；与开始时间相同视为不启用",
                "type": "string",
                "default": "07:00"
            }
        }
    }
}
